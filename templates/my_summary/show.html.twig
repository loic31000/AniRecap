{% extends 'base.html.twig' %}

{% block title %}{{ summary.title }}{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('css/my-summaries.css') }}">{% endblock %}

{% block body %}
    {{ component('Header', {backRoute: 'app_my_summaries'}) }}
    <main class="my-summaries-shell summary-detail">
        {% include 'components/_flash_messages.html.twig' %}
        <a class="my-summaries-back" href="{{ path('app_my_summaries') }}">← Retour à Mes résumés</a>
        <span class="summary-detail__parent">{{ parent_label }}</span>
        <h1>{{ summary.title }}</h1>
        {% if summary.spoilerLevel and summary.spoilerLevel != 'aucun' %}
            <details class="summary-spoiler">
                <summary>Révéler le résumé — spoiler {{ summary.spoilerLevel }}</summary>
                <div>{{ summary.content|striptags|nl2br }}</div>
            </details>
        {% else %}
            <div class="summary-detail__content">{{ summary.content|striptags|nl2br }}</div>
        {% endif %}
        <p class="summary-detail__spoiler">Niveau de spoiler : {{ summary.spoilerLevel|default('aucun') }}</p>
        <div class="summary-detail__actions">
            <a href="{{ path('app_summary_edit', {id: summary.id}) }}">Modifier</a>
            <a href="{{ path('app_summary_delete_confirm', {id: summary.id}) }}">Effacer</a>
        </div>
    </main>
    {{ component('Navbar', {active: 'profile'}) }}
{% endblock %}
