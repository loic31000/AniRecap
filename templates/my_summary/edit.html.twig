{% extends 'base.html.twig' %}

{% block title %}Modifier {{ content_type|lower }}{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('css/my-summaries.css') }}">{% endblock %}

{% block body %}
    {{ component('Header', {backRoute: 'app_my_summaries'}) }}
    <main class="my-summaries-shell management-form-page">
        <a class="my-summaries-back" href="{{ path('app_my_summaries') }}">← Annuler et revenir</a>
        <h1>Modifier {{ content_type }}</h1>
        <p>{{ content_title }}</p>
        {{ form_start(form, {attr: {class: 'management-form'}}) }}
            {% if form.vars.submitted and not form.vars.valid %}
                <div class="management-form__errors" role="alert">Vérifiez les champs signalés ci-dessous.</div>
            {% endif %}
            {{ form_rest(form) }}
        {{ form_end(form) }}
    </main>
    {{ component('Navbar', {active: 'profile'}) }}
{% endblock %}
