<article class="summary-list-card">
    {% if card.openRoute %}
        <a class="summary-list-card__open-link" href="{{ path(card.openRoute, card.openParameters) }}" aria-label="Ouvrir le contenu associé à {{ card.title }}"></a>
    {% endif %}
    <span class="summary-list-card__media">
        {% if card.image|default('')|trim is not empty %}
            <img src="{{ card.image }}" alt="Miniature du contenu associé à {{ card.title }}">
        {% else %}
            <span class="summary-list-card__placeholder" aria-hidden="true"><i class="fa-regular fa-image"></i></span>
        {% endif %}
    </span>
    <div class="summary-list-card__body">
        <span class="summary-list-card__badge">{{ card.typeLabel }}</span>
        <strong>{{ card.title }}</strong>
        {% if card.description|default('')|striptags|trim is not empty %}
            <span class="summary-list-card__excerpt">{{ card.description|striptags }}</span>
        {% endif %}
        <span class="summary-list-card__parent">{{ card.parentLabel }}</span>
        {% if card.editRoute %}
            <a class="summary-card-edit" href="{{ path(card.editRoute, {id: card.editId}) }}" aria-label="Modifier {{ card.title }}">
                <i class="fa-solid fa-pencil" aria-hidden="true"></i>
            </a>
        {% endif %}
    </div>
    {% include 'components/_summary_like_toggle.html.twig' with {state: card.likeState|default(null)} only %}
</article>
