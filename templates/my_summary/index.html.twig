{% extends 'base.html.twig' %}

{% block title %}Mes résumés{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/my-summaries.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
{% endblock %}

{% block body %}
    <div class="my-summaries-page" id="my-summaries-top">
        {{ component('Header', {backRoute: 'app_profile'}) }}
        <main class="my-summaries-shell">
            {% include 'components/_flash_messages.html.twig' %}
            <a class="my-summaries-back" href="{{ path('app_profile') }}">← Retour au Profil</a>
            <h1><span>私の要約</span> Mes Résumés</h1>
            <p class="my-summaries-intro">Retrouvez vos contenus de synthèse enregistrés.</p>

            {% if summary_cards is empty %}
                <section class="management-empty" role="status">
                    <p>Vous n’avez encore enregistré aucun résumé.</p>
                    <a href="{{ path('app_catalogue') }}">Découvrir le Catalogue</a>
                </section>
            {% else %}
                <div class="summary-list-grid">
                    {% for card in summary_cards %}
                        {% include 'my_summary/_summary_card.html.twig' with {card: card} only %}
                    {% endfor %}
                </div>
            {% endif %}

            {% include 'components/_scroll_top.html.twig' with {target: 'my-summaries-top'} only %}
        </main>
        {{ component('Navbar', {active: 'profile'}) }}
    </div>
{% endblock %}
