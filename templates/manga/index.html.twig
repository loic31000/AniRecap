{% extends 'base.html.twig' %}

{% block title %}{{ manga.title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/manga.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
{% endblock %}

{% block body %}
    {% set cover = manga.coverMangaUrl ?: asset('images/coverManga.png') %}

    {{ component('Header', { backRoute: 'app_catalogue' }) }}

    <main class="page-manga">
        <div class="manga-inner">
            <a href="{{ path('app_catalogue') }}" class="back-link">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                <span>Retour au Catalogue</span>
            </a>

            <section class="manga-hero">
                <figure class="manga-cover" style="background-image: url('{{ cover }}');">
                    <span class="visually-hidden">Affiche de {{ manga.title }}</span>
                </figure>
                <div class="manga-copy">
                    <h1 class="manga-title"><span class="manga-title__main">{{ manga.title }}</span></h1>
                    <div class="badge-row">
                        {% for category in manga.categorie %}
                            <span class="badge">{{ category.name|upper }}</span>
                        {% endfor %}
                        {% if not manga.isPublic %}
                            <span class="badge">PRIVÉ</span>
                        {% endif %}
                    </div>
                </div>
            </section>

            <section class="panel panel--synopsis" aria-labelledby="synopsis-title">
                <h2 id="synopsis-title" class="section-title">Synopsis complet</h2>
                {% if manga.synopsis %}
                    <p class="synopsis">{{ manga.synopsis }}</p>
                {% else %}
                    <p class="synopsis">Aucun synopsis renseigné.</p>
                {% endif %}
                <div class="info-grid">
                    <article class="info-item"><p class="info-label">TYPE</p><p class="info-value">{{ manga.type ?: 'Non renseigné' }}</p></article>
                    <article class="info-item"><p class="info-label">STATUT</p><p class="info-value">{{ manga.status ?: 'Non renseigné' }}</p></article>
                    <article class="info-item"><p class="info-label">AUTEUR</p><p class="info-value">{{ manga.author ?: 'Non renseigné' }}</p></article>
                    <article class="info-item"><p class="info-label">ANNÉE</p><p class="info-value">{{ manga.mangaDate ?: 'Non renseignée' }}</p></article>
                </div>
            </section>

            <section class="panel panel--chapters" aria-labelledby="manga-structure-title">
                <h2 id="manga-structure-title" class="section-title">Structure</h2>
                <p>
                    Tomes :
                    {{ manga.tomeStart ?: 'non renseigné' }}
                    {% if manga.tomeEnd and manga.tomeEnd != manga.tomeStart %} à {{ manga.tomeEnd }}{% endif %}
                </p>
                <p>
                    Chapitres :
                    {{ manga.chapterStart ?: 'non renseigné' }}
                    {% if manga.chapterEnd and manga.chapterEnd != manga.chapterStart %} à {{ manga.chapterEnd }}{% endif %}
                </p>
            </section>
        </div>
    </main>

    {{ component('Navbar', { active: 'catalogue' }) }}
{% endblock %}
