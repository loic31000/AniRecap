{% extends 'base.html.twig' %}

{% block title %}{{ manga.title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/manga.css') }}">
    <link rel="stylesheet" href="{{ asset('css/spoiler-card.css') }}">
    <link rel="stylesheet" href="{{ asset('css/oeuvreCard.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
{% endblock %}

{% block body %}
    {% set cover = manga.coverMangaUrl ?: asset('images/coverManga.png') %}
    {% set return_to = app.request.query.get('return_to') %}
    {% set return_url = return_to and return_to starts with '/' and not (return_to starts with '//') ? return_to : path('app_catalogue') %}

    {{ component('Header', { backRoute: 'app_catalogue' }) }}

    <main class="page-manga">
        <div class="manga-inner">
            {% include 'components/_flash_messages.html.twig' %}
            <a href="{{ return_url }}" class="back-link">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                <span>Retour</span>
            </a>

            <section class="manga-hero">
                <figure class="manga-cover" style="background-image: url('{{ cover }}');">
                    <span class="visually-hidden">Affiche de {{ manga.title }}</span>
                </figure>
                <div class="manga-copy">
                    <h1 class="manga-title"><span class="manga-title__main">{{ manga.title }}</span></h1>
                    <div class="badge-row">
                        {% for category in manga.categorie %}
                            <span class="badge">{{ category.name|upper }}</span>
                        {% endfor %}
                        {% if not manga.isPublic %}
                            <span class="badge">PRIVÉ</span>
                        {% endif %}
                    </div>
                    <div class="detail-favorite-action">{% include 'components/_favorite_toggle.html.twig' with {oeuvre: favorite_oeuvre, modifier: 'favorite-toggle-form--detail', label: favorite_oeuvre.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris'} only %}</div>
                </div>
            </section>

            <section class="panel panel--synopsis" aria-labelledby="synopsis-title">
                <h2 id="synopsis-title" class="section-title section-title--bilingual"><span lang="ja">あらすじ（全文）</span><span>Synopsis complet</span></h2>
                {% if manga.synopsis %}
                    <p class="synopsis">{{ manga.synopsis }}</p>
                {% else %}
                    <p class="synopsis">Aucun synopsis renseigné.</p>
                {% endif %}
                <div class="info-grid">
                    <article class="info-item"><p class="info-label"><span lang="ja">タイプ</span><span>TYPE</span></p><p class="info-value">{{ manga.type ?: 'Non renseigné' }}</p></article>
                    <article class="info-item"><p class="info-label"><span lang="ja">定款</span><span>STATUT</span></p><p class="info-value">{{ manga.status ?: 'Non renseigné' }}</p></article>
                    <article class="info-item"><p class="info-label"><span lang="ja">著者</span><span>AUTEUR</span></p><p class="info-value">{{ manga.author ?: 'Non renseigné' }}</p></article>
                    <article class="info-item"><p class="info-label"><span lang="ja">年</span><span>ANNÉE</span></p><p class="info-value">{{ manga.releaseDate ? manga.releaseDate|date('Y') : 'Non renseignée' }}</p></article>
                </div>
            </section>

            {% if is_owner or tomes is not empty or chapitres is not empty %}
                <section class="manga-content-tabs" data-controller="manga-tabs">
                    <div class="manga-tabs-toolbar">
                        <div class="tabs-row" role="tablist" aria-label="Contenus du manga">
                            <button
                                type="button"
                                id="chapitres-tab"
                                class="tab-btn is-active"
                                role="tab"
                                aria-selected="true"
                                aria-controls="chapitres-panel"
                                tabindex="0"
                                data-manga-tabs-target="tab"
                                data-panel="chapitres"
                                data-action="click->manga-tabs#select keydown->manga-tabs#navigate"
                            >Chapitres</button>
                            <button
                                type="button"
                                id="tomes-tab"
                                class="tab-btn"
                                role="tab"
                                aria-selected="false"
                                aria-controls="tomes-panel"
                                tabindex="-1"
                                data-manga-tabs-target="tab"
                                data-panel="tomes"
                                data-action="click->manga-tabs#select keydown->manga-tabs#navigate"
                            >Tomes</button>
                        </div>
                    </div>

                    <div
                        id="chapitres-panel"
                        class="manga-tab-panel"
                        role="tabpanel"
                        aria-labelledby="chapitres-tab"
                        data-manga-tabs-target="panel"
                        data-panel="chapitres"
                    >
                        <div class="manga-tab-actions">
                            <p class="episode-count-meta">{{ chapitres|length }} chapitre{{ chapitres|length > 1 ? 's' : '' }} disponible{{ chapitres|length > 1 ? 's' : '' }}</p>
                            {% if is_owner_private %}<a href="{{ path('app_forms_chapitre_create', {mangaId: manga.id, return_to: app.request.requestUri}) }}" class="chip-btn private-content-add">Ajouter un chapitre</a>{% endif %}
                        </div>
                        {% if chapitres is empty %}
                            <p class="episode-count-meta manga-empty-state">Aucun chapitre n’a encore été ajouté à ce manga.</p>
                        {% else %}
                            <div class="episodes-timeline-list">
                                {% for chapitre in chapitres %}
                                    {% set linkedDiaporamas = chapitre_diaporamas[chapitre.id]|default([]) %}
                                    <div class="manga-timeline-entry">
                                        <span class="manga-timeline-node" aria-hidden="true"><i class="fa-solid fa-play"></i></span>
                                        {% include 'components/_spoiler_card.html.twig' with {item_id: chapitre.id, title: chapitre.title, summary: chapitre.synopsis, status: chapitre.status, badge: 'CHAP ' ~ chapitre.number, image_url: chapitre.coverChapitreUrl, effective_level: chapitre_spoiler_levels[chapitre.id], linked_diaporamas: linkedDiaporamas, edit_route: 'app_forms_chapitre_edit', edit_class: 'content-card-edit', delete_route: 'app_forms_chapitre_delete', delete_token_id: 'chapitre_delete_', delete_message: 'Supprimer définitivement ce chapitre, son résumé et ses scènes associées ?', delete_label: 'Supprimer ' ~ chapitre.title, summary_state: chapitre_summary_states[chapitre.id]|default(null), can_edit: is_owner} only %}
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <div
                        id="tomes-panel"
                        class="manga-tab-panel"
                        role="tabpanel"
                        aria-labelledby="tomes-tab"
                        data-manga-tabs-target="panel"
                        data-panel="tomes"
                        hidden
                    >
                        <div class="manga-tab-actions">
                            <p class="episode-count-meta">{{ tomes|length }} tome{{ tomes|length > 1 ? 's' : '' }} disponible{{ tomes|length > 1 ? 's' : '' }}</p>
                            {% if is_owner_private %}<a href="{{ path('app_forms_tome_create', {mangaId: manga.id, return_to: app.request.requestUri}) }}" class="chip-btn private-content-add">Ajouter un tome</a>{% endif %}
                        </div>
                        {% if tomes is empty %}
                            <p class="episode-count-meta manga-empty-state">Aucun tome n’a encore été ajouté à ce manga.</p>
                        {% else %}
                            <div class="episodes-timeline-list">
                                {% for tome in tomes %}
                                    {% set linkedDiaporamas = tome_diaporamas[tome.id]|default([]) %}
                                    <div class="manga-timeline-entry">
                                        <span class="manga-timeline-node" aria-hidden="true"><i class="fa-solid fa-play"></i></span>
                                        {% include 'components/_spoiler_card.html.twig' with {item_id: tome.id, title: tome.title, summary: tome.synopsis, status: tome.status, badge: 'TOME ' ~ tome.number, image_url: tome.coverTomeUrl, effective_level: tome_spoiler_levels[tome.id], linked_diaporamas: linkedDiaporamas, edit_route: 'app_forms_tome_edit', edit_class: 'content-card-edit', delete_route: 'app_forms_tome_delete', delete_token_id: 'tome_delete_', delete_message: 'Supprimer définitivement ce tome, son résumé et ses scènes associées ?', delete_label: 'Supprimer ' ~ tome.title, summary_state: tome_summary_states[tome.id]|default(null), can_edit: is_owner} only %}
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </section>
            {% endif %}

            <section class="manga-characters" aria-labelledby="manga-characters-title">
                <h2 id="manga-characters-title" class="section-title section-title--bilingual"><span lang="ja">登場人物</span><span>Personnages</span></h2>
                {% if characters is empty %}
                    <p class="manga-characters-empty">Aucun personnage n'a encore été ajouté à ce manga.</p>
                {% else %}
                    <div class="manga-characters-grid">
                        {% for character in characters %}
                            {% include 'components/_spoiler_card.html.twig' with {variant: 'character', effective_level: character.spoilerLevel, image_url: character.imageUrl ? path('app_character_image', {id: character.id}) : null, title: character.name, detail_url: path('app_character_show', {id: character.id, return_to: app.request.requestUri})} only %}
                        {% endfor %}
                    </div>
                {% endif %}
            </section>
        </div>
    </main>

    {{ component('Navbar', { active: 'catalogue' }) }}
{% endblock %}
