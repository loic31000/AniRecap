{% extends 'base.html.twig' %}

{% block title %}{{ manga.title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/manga.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
{% endblock %}

{% block body %}
    {% set cover = manga.coverMangaUrl ?: asset('images/coverManga.png') %}

    {{ component('Header', { backRoute: 'app_catalogue' }) }}

    <main class="page-manga">
        <div class="manga-inner">
            <a href="{{ path('app_catalogue') }}" class="back-link">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                <span>Retour au Catalogue</span>
            </a>

            <section class="manga-hero">
                <figure class="manga-cover" style="background-image: url('{{ cover }}');">
                    <span class="visually-hidden">Affiche de {{ manga.title }}</span>
                </figure>
                <div class="manga-copy">
                    <h1 class="manga-title"><span class="manga-title__main">{{ manga.title }}</span></h1>
                    <div class="badge-row">
                        {% for category in manga.categorie %}
                            <span class="badge">{{ category.name|upper }}</span>
                        {% endfor %}
                        {% if not manga.isPublic %}
                            <span class="badge">PRIVÉ</span>
                        {% endif %}
                    </div>
                </div>
            </section>

            <section class="panel panel--synopsis" aria-labelledby="synopsis-title">
                <h2 id="synopsis-title" class="section-title">Synopsis complet</h2>
                {% if manga.synopsis %}
                    <p class="synopsis">{{ manga.synopsis }}</p>
                {% else %}
                    <p class="synopsis">Aucun synopsis renseigné.</p>
                {% endif %}
                <div class="info-grid">
                    <article class="info-item"><p class="info-label">TYPE</p><p class="info-value">{{ manga.type ?: 'Non renseigné' }}</p></article>
                    <article class="info-item"><p class="info-label">STATUT</p><p class="info-value">{{ manga.status ?: 'Non renseigné' }}</p></article>
                    <article class="info-item"><p class="info-label">AUTEUR</p><p class="info-value">{{ manga.author ?: 'Non renseigné' }}</p></article>
                    <article class="info-item"><p class="info-label">ANNÉE</p><p class="info-value">{{ manga.mangaDate ?: 'Non renseignée' }}</p></article>
                </div>
            </section>

            {% if is_owner_private %}
                <section class="manga-content-tabs" data-controller="manga-tabs">
                    <div class="manga-tabs-toolbar">
                        <div class="tabs-row" role="tablist" aria-label="Contenus du manga">
                            <button
                                type="button"
                                id="chapitres-tab"
                                class="tab-btn is-active"
                                role="tab"
                                aria-selected="true"
                                aria-controls="chapitres-panel"
                                tabindex="0"
                                data-manga-tabs-target="tab"
                                data-panel="chapitres"
                                data-action="click->manga-tabs#select keydown->manga-tabs#navigate"
                            >Chapitres</button>
                            <button
                                type="button"
                                id="tomes-tab"
                                class="tab-btn"
                                role="tab"
                                aria-selected="false"
                                aria-controls="tomes-panel"
                                tabindex="-1"
                                data-manga-tabs-target="tab"
                                data-panel="tomes"
                                data-action="click->manga-tabs#select keydown->manga-tabs#navigate"
                            >Tomes</button>
                        </div>
                    </div>

                    <div
                        id="chapitres-panel"
                        class="manga-tab-panel"
                        role="tabpanel"
                        aria-labelledby="chapitres-tab"
                        data-manga-tabs-target="panel"
                        data-panel="chapitres"
                    >
                        <div class="manga-tab-actions">
                            <p class="episode-count-meta">{{ chapitres|length }} chapitre{{ chapitres|length > 1 ? 's' : '' }} disponible{{ chapitres|length > 1 ? 's' : '' }}</p>
                            <a href="{{ path('app_forms_chapitre_create', {mangaId: manga.id}) }}" class="chip-btn private-content-add">Ajouter un chapitre</a>
                        </div>
                        {% if chapitres is empty %}
                            <p class="episode-count-meta manga-empty-state">Aucun chapitre n’a encore été ajouté à ce manga.</p>
                        {% else %}
                            <div class="episodes-timeline-list">
                                {% for chapitre in chapitres %}
                                    {% set linkedDiaporamas = chapitre_diaporamas[chapitre.id]|default([]) %}
                                    <div class="manga-timeline-entry">
                                        <span class="manga-timeline-node" aria-hidden="true"><i class="fa-solid fa-play"></i></span>
                                        <article class="episode-figma-card{{ linkedDiaporamas|length == 1 ? ' has-diaporama-link' : '' }}">
                                            {% if linkedDiaporamas|length == 1 %}
                                                <a
                                                    href="{{ path('app_diaporama_show', {id: linkedDiaporamas[0].id}) }}"
                                                    class="card-diaporama-overlay"
                                                    aria-label="Voir le diaporama {{ linkedDiaporamas[0].title }} lié au chapitre {{ chapitre.number }}"
                                                ></a>
                                            {% endif %}
                                            <div class="card-media-wrap"><img src="{{ chapitre.coverChapitreUrl }}" alt="Miniature du chapitre {{ chapitre.number }}" class="card-banner"></div>
                                            <div class="card-content-wrap">
                                                <div class="card-meta-line">
                                                    <span class="badge-episodes">CHAP {{ chapitre.number }}</span>
                                                    <span class="content-card-status">{{ chapitre.status }}</span>
                                                </div>
                                                <h3 class="card-episode-title">{{ chapitre.title }}</h3>
                                                <p class="card-episode-desc">{{ chapitre.synopsis }}</p>
                                                <div class="content-card-footer">
                                                    <span class="content-card-spoiler">{{ chapitre.spoilerLevel.value|upper }}</span>
                                                    {% if linkedDiaporamas|length == 1 %}
                                                        <span class="card-diaporama-hint" aria-hidden="true">Voir le diaporama</span>
                                                    {% elseif linkedDiaporamas|length > 1 %}
                                                        <details class="card-diaporama-list">
                                                            <summary>Voir les diaporamas ({{ linkedDiaporamas|length }})</summary>
                                                            <ul>
                                                                {% for diaporama in linkedDiaporamas %}
                                                                    <li><a href="{{ path('app_diaporama_show', {id: diaporama.id}) }}">{{ diaporama.title }}</a></li>
                                                                {% endfor %}
                                                            </ul>
                                                        </details>
                                                    {% endif %}
                                                    <a href="{{ path('app_forms_chapitre_edit', {id: chapitre.id}) }}" class="content-card-edit" aria-label="Modifier le chapitre {{ chapitre.number }}">
                                                        <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                                        <span class="visually-hidden">Modifier</span>
                                                    </a>
                                                </div>
                                            </div>
                                        </article>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <div
                        id="tomes-panel"
                        class="manga-tab-panel"
                        role="tabpanel"
                        aria-labelledby="tomes-tab"
                        data-manga-tabs-target="panel"
                        data-panel="tomes"
                        hidden
                    >
                        <div class="manga-tab-actions">
                            <p class="episode-count-meta">{{ tomes|length }} tome{{ tomes|length > 1 ? 's' : '' }} disponible{{ tomes|length > 1 ? 's' : '' }}</p>
                            <a href="{{ path('app_forms_tome_create', {mangaId: manga.id}) }}" class="chip-btn private-content-add">Ajouter un tome</a>
                        </div>
                        {% if tomes is empty %}
                            <p class="episode-count-meta manga-empty-state">Aucun tome n’a encore été ajouté à ce manga.</p>
                        {% else %}
                            <div class="episodes-timeline-list">
                                {% for tome in tomes %}
                                    {% set linkedDiaporamas = tome_diaporamas[tome.id]|default([]) %}
                                    <div class="manga-timeline-entry">
                                        <span class="manga-timeline-node" aria-hidden="true"><i class="fa-solid fa-play"></i></span>
                                        <article class="episode-figma-card{{ linkedDiaporamas|length == 1 ? ' has-diaporama-link' : '' }}">
                                            {% if linkedDiaporamas|length == 1 %}
                                                <a
                                                    href="{{ path('app_diaporama_show', {id: linkedDiaporamas[0].id}) }}"
                                                    class="card-diaporama-overlay"
                                                    aria-label="Voir le diaporama {{ linkedDiaporamas[0].title }} lié au tome {{ tome.number }}"
                                                ></a>
                                            {% endif %}
                                            <div class="card-media-wrap"><img src="{{ tome.coverTomeUrl }}" alt="Miniature du tome {{ tome.number }}" class="card-banner"></div>
                                            <div class="card-content-wrap">
                                                <div class="card-meta-line">
                                                    <span class="badge-episodes">TOME {{ tome.number }}</span>
                                                    <span class="content-card-status">{{ tome.status }}</span>
                                                </div>
                                                <h3 class="card-episode-title">{{ tome.title }}</h3>
                                                <p class="card-episode-desc">{{ tome.synopsis }}</p>
                                                <div class="content-card-footer">
                                                    <span class="content-card-spoiler">{{ tome.spoilerLevel.value|upper }}</span>
                                                    {% if linkedDiaporamas|length == 1 %}
                                                        <span class="card-diaporama-hint" aria-hidden="true">Voir le diaporama</span>
                                                    {% elseif linkedDiaporamas|length > 1 %}
                                                        <details class="card-diaporama-list">
                                                            <summary>Voir les diaporamas ({{ linkedDiaporamas|length }})</summary>
                                                            <ul>
                                                                {% for diaporama in linkedDiaporamas %}
                                                                    <li><a href="{{ path('app_diaporama_show', {id: diaporama.id}) }}">{{ diaporama.title }}</a></li>
                                                                {% endfor %}
                                                            </ul>
                                                        </details>
                                                    {% endif %}
                                                    <a href="{{ path('app_forms_tome_edit', {id: tome.id}) }}" class="content-card-edit" aria-label="Modifier le tome {{ tome.number }}">
                                                        <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                                        <span class="visually-hidden">Modifier</span>
                                                    </a>
                                                </div>
                                            </div>
                                        </article>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </section>
            {% endif %}

            <section class="manga-characters" aria-labelledby="manga-characters-title">
                <h2 id="manga-characters-title" class="section-title">Personnages</h2>
                {% if characters is empty %}
                    <p class="manga-characters-empty">Aucun personnage n'a encore été ajouté à ce manga.</p>
                {% else %}
                    <div class="manga-characters-grid">
                        {% for character in characters %}
                            <article class="manga-character-card">
                                {% if character.imageUrl %}
                                    <img
                                        src="{{ asset(character.imageUrl) }}"
                                        alt="Portrait de {{ character.name }}"
                                        class="manga-character-portrait"
                                        loading="lazy"
                                    >
                                {% else %}
                                    <span class="manga-character-portrait manga-character-placeholder" role="img" aria-label="Portrait non disponible pour {{ character.name }}">
                                        <i class="fa-solid fa-user" aria-hidden="true"></i>
                                    </span>
                                {% endif %}
                                <h3 class="manga-character-name">{{ character.name }}</h3>
                            </article>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>
        </div>
    </main>

    {{ component('Navbar', { active: 'catalogue' }) }}
{% endblock %}
