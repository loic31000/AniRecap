{% extends 'base.html.twig' %}

{% block title %}{{ is_edit ? 'Modifier un manga' : 'Ajouter un synopsis manga' }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/forms.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
{% endblock %}

{% block body %}
    {% set return_to = app.request.query.get('return_to') %}
    {% set return_url = return_to and return_to starts with '/' and not (return_to starts with '//') ? return_to : path('app_forms_index') %}
    <header class="synopsis-editor-hero">
        <a href="{{ return_url }}" aria-label="Retour à la page précédente">
            {% include 'forms/_back_icon.html.twig' %}
        </a>
        <h1>{{ is_edit ? 'Modifier un Manga' : 'Ajouter un Synopsis' }}</h1>
    </header>

    <main class="forms-page forms-page--editor" id="main-content" tabindex="-1">
        <div class="forms-shell synopsis-editor">
            <header class="synopsis-editor__intro">
                <h2>{{ is_edit ? 'MODIFIER LE MANGA' : 'NOUVEAU SYNOPSIS' }}</h2>
                <p>{{ is_edit ? 'Mettez à jour votre œuvre et ses catégories.' : 'Créez un récapitulatif immersif.' }}</p>
            </header>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash-{{ label }}" role="{{ label == 'error' ? 'alert' : 'status' }}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {{ form_start(form, { attr: { enctype: 'multipart/form-data', class: 'synopsis-form' } }) }}
                {% if form.vars.submitted and not form.vars.valid %}
                    <section class="form-error-summary" role="alert" aria-labelledby="manga-form-errors">
                        <h2 id="manga-form-errors">Vérifiez les informations suivantes :</h2>
                        <ul>
                            {% for error in form.vars.errors %}
                                <li>{{ error.message }}</li>
                            {% endfor %}
                            {% for field in form %}
                                {% for error in field.vars.errors|default([]) %}
                                    <li>
                                        <a href="#{{ field.vars.id }}">{{ field.vars.label }} : {{ error.message }}</a>
                                    </li>
                                {% endfor %}
                            {% endfor %}
                        </ul>
                    </section>
                {% endif %}

                <div class="synopsis-upload-field" data-controller="upload-preview">
                    {{ form_label(form.image) }}
                    {% if current_cover_url %}
                        <img src="{{ current_cover_url }}" alt="Miniature actuelle du manga" class="synopsis-current-cover">
                    {% endif %}
                    <label class="synopsis-upload-zone" for="{{ form.image.vars.id }}">
                        <span class="synopsis-upload-zone__icon" aria-hidden="true">
                            <i class="fa-regular fa-image"></i>
                            <i class="fa-solid fa-plus"></i>
                        </span>
                        <strong>{{ is_edit ? 'Remplacer la miniature' : 'Cliquez pour importer' }}</strong>
                        <small>PNG, JPG (9:16 recommandé)</small>
                    </label>
                    {{ form_widget(form.image, { attr: { class: 'synopsis-upload-input' } }) }}
                    {{ form_errors(form.image) }}
                </div>
                {{ form_row(form.title) }}
                {{ include('forms/_category_selector.html.twig', { field: form.categories }) }}
                {{ form_row(form.synopsis) }}

                <fieldset class="synopsis-fieldset synopsis-fieldset--plain">
                    {{ form_row(form.sourceType) }}
                    {{ form_row(form.status) }}
                    {{ form_row(form.author) }}
                    {{ form_row(form.releaseDate) }}
                </fieldset>

                <fieldset class="synopsis-fieldset synopsis-fieldset--range">
                    <legend>Numéro ou plage de tome</legend>
                    {{ form_row(form.tomeStart) }}
                    {{ form_row(form.tomeEnd) }}
                </fieldset>

                <fieldset class="synopsis-fieldset synopsis-fieldset--range">
                    <legend>Numéro ou plage de chapitre</legend>
                    {{ form_row(form.chapterStart) }}
                    {{ form_row(form.chapterEnd) }}
                </fieldset>

                <div class="synopsis-save-bar">
                    {{ form_widget(form.save) }}
                </div>
            {{ form_end(form) }}
        </div>
    </main>

    {{ component('Navbar', { active: 'forms' }) }}
{% endblock %}
