{% extends 'base.html.twig' %}

{% block title %}Formulaires de création{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/forms.css') }}">
{% endblock %}

{% block body %}
    <main class="forms-page forms-page--menu" id="main-content" tabindex="-1">
        <section class="forms-shell forms-menu" aria-labelledby="forms-menu-title">
            <header class="forms-heading">
                <span class="forms-heading__line" aria-hidden="true"></span>
                <h1 id="forms-menu-title">
                    <span lang="ja">フォーム</span>
                    Création
                </h1>
            </header>

            <nav class="forms-list" aria-label="Choisir un éditeur">
                <a class="forms-card" href="{{ path('app_forms_anime_synopsis') }}">
                    <span class="forms-card__icon" aria-hidden="true">
                        <i class="fa-solid fa-file-pen"></i>
                    </span>
                    <span class="forms-card__content">
                        <strong>Éditeur de Synopsis Animé</strong>
                        <small>Rédiger le contenu détaillé</small>
                    </span>
                </a>

                <a class="forms-card" href="{{ path('app_forms_season') }}">
                    <span class="forms-card__icon" aria-hidden="true">
                        <i class="fa-solid fa-file-pen"></i>
                    </span>
                    <span class="forms-card__content">
                        <strong>Éditeur de Saison</strong>
                        <small>Rédiger le contenu détaillé</small>
                    </span>
                </a>

                <a class="forms-card" href="{{ path('app_forms_season_scene') }}">
                    <span class="forms-card__icon" aria-hidden="true">
                        <i class="fa-solid fa-film"></i>
                    </span>
                    <span class="forms-card__content">
                        <strong>Éditeur de Scène Saison</strong>
                        <small>Rédiger le contenu détaillé</small>
                    </span>
                </a>

                <a class="forms-card" href="{{ path('app_forms_manga_synopsis') }}">
                    <span class="forms-card__icon" aria-hidden="true">
                        <i class="fa-solid fa-file-pen"></i>
                    </span>
                    <span class="forms-card__content">
                        <strong>Éditeur de Synopsis Manga</strong>
                        <small>Rédiger le contenu détaillé</small>
                    </span>
                </a>

                <a class="forms-card" href="{{ path('app_forms_manga_scene') }}">
                    <span class="forms-card__icon" aria-hidden="true">
                        <i class="fa-solid fa-film"></i>
                    </span>
                    <span class="forms-card__content">
                        <strong>Éditeur de Scène Manga</strong>
                        <small>Rédiger le contenu détaillé</small>
                    </span>
                </a>

                <a class="forms-card" href="{{ path('app_forms_character') }}">
                    <span class="forms-card__icon" aria-hidden="true">
                        <i class="fa-solid fa-user"></i>
                    </span>
                    <span class="forms-card__content">
                        <strong>Éditeur de Personnage</strong>
                        <small>Rédiger le contenu détaillé</small>
                    </span>
                </a>
            </nav>

            <a class="forms-menu__close" href="{{ path('app_home') }}" aria-label="Fermer le menu de création">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </a>
        </section>
    </main>
{% endblock %}
