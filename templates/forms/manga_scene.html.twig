{% extends 'base.html.twig' %}

{% block title %}Ajouter une scène Manga{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/forms.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
{% endblock %}

{% block body %}
    {% set return_to = app.request.query.get('return_to') %}
    {% set fallback_url = diaporama ? path('app_diaporama_show', {id: diaporama.id}) : path('app_forms_index') %}
    {% set return_url = return_to and return_to starts with '/' and not (return_to starts with '//') ? return_to : fallback_url %}
    <header class="synopsis-editor-hero">
        <a href="{{ return_url }}" aria-label="Retour à la page précédente">{% include 'forms/_back_icon.html.twig' %}</a>
        <h1>Ajouter une Scène Manga</h1>
    </header>

    <main class="forms-page forms-page--editor">
        <div class="forms-shell synopsis-editor">
            <header class="synopsis-editor__intro">
                <h2>ÉDITER LA SCÈNE</h2>
                <p>{{ diaporama ? diaporama.title ~ ' : ajoutez une nouvelle scène.' : 'Choisissez exclusivement le tome ou le chapitre parent de la première scène.' }}</p>
            </header>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash-{{ label }}" role="{{ label == 'error' ? 'alert' : 'status' }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {{ form_start(form, {attr: {enctype: 'multipart/form-data', class: 'synopsis-form', 'data-controller': 'manga-scene-target'}}) }}
                {% if form.vars.submitted and not form.vars.valid %}
                    <section class="form-error-summary" role="alert">
                        <h2>Vérifiez les informations suivantes :</h2>
                        <ul>
                            {% for field in form %}
                                {% for error in field.vars.errors|default([]) %}
                                    <li><a href="#{{ field.vars.id }}">{{ field.vars.label }} : {{ error.message }}</a></li>
                                {% endfor %}
                            {% endfor %}
                        </ul>
                    </section>
                {% endif %}

                <div class="synopsis-upload-field" data-controller="upload-preview">
                    {{ form_label(form.image) }}
                    <label class="synopsis-upload-zone" for="{{ form.image.vars.id }}">
                        <strong>Cliquez pour importer</strong>
                        <small>PNG ou JPG, format 16:9 recommandé</small>
                    </label>
                    {{ form_widget(form.image, {attr: {class: 'synopsis-upload-input'}}) }}
                    {{ form_errors(form.image) }}
                </div>
                {{ form_row(form.targetType) }}
                <div class="scene-manga-targets">
                    <div data-manga-scene-target-target="tome">{{ form_row(form.tomeId) }}</div>
                    <div data-manga-scene-target-target="chapitre">{{ form_row(form.chapitreId) }}</div>
                </div>
                {{ form_row(form.title) }}
                {{ form_row(form.content) }}
                {{ form_row(form.spoilerLevel) }}
                <div class="synopsis-save-bar">{{ form_widget(form.save) }}</div>
            {{ form_end(form) }}
        </div>
    </main>

    {{ component('Navbar', {active: 'forms'}) }}
{% endblock %}
