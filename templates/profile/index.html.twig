{# templates/profile/profile.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}
	{{ 'Profil'|default('Profil') }}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/profile.css') }}">
	<link rel="stylesheet" href="{{ asset('css/oeuvreCard.css') }}">
	<link rel="stylesheet" href="{{ asset('css/my-summaries.css') }}">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
{% endblock %}

{% block body %}
	{% set avatar = user.avatar is defined and user.avatar is not empty ? user.avatar : asset('images/avatarDefault.png') %}
	{% set username = user.username %}
	{% set email = user.email %}
	{% set synopsisCount = user.synopsisCount %}
	{% set favoritesCount = user.favoritesCount %}
	{% set favoritesList = user.favorites %}

	{{ component('Header', { backRoute: null }) }}

	<main class="page-profile" id="main-content" tabindex="-1">
		<div class="profile-inner">

			{% include 'components/_flash_messages.html.twig' %}

			<h1 class="profile-page-title">
				<span class="jp" lang="ja">プロフィール</span>
				<span>Profil</span>
			</h1>

			<section class="profile-identity" aria-label="Identité du compte">
				<div class="profile-avatar-wrap">
					<img src="{{ avatar }}" alt="Avatar de {{ username }}" class="profile-avatar">

					<form action="{{ path('app_profile_upload') }}" method="post" enctype="multipart/form-data" class="avatar-upload-form" data-controller="avatar-upload">
						<input type="hidden" name="_token" value="{{ csrf_token('avatar_upload') }}">
						<button type="button" class="avatar-edit-btn" title="Changer l'avatar" aria-label="Changer l’avatar" data-action="avatar-upload#choose">
							<i class="fa-solid fa-pencil" aria-hidden="true"></i>
						</button>
						<input id="avatarInput" class="visually-hidden" type="file" name="avatar" accept="image/png,image/jpeg" data-avatar-upload-target="input" data-action="change->avatar-upload#submit">
						<p class="visually-hidden" role="status" aria-live="polite" data-avatar-upload-target="status"></p>
					</form>
				</div>

				<p class="profile-username">{{ username }}</p>
				<p class="profile-email">{{ email }}</p>

				<div class="profile-stats">
					<div class="stat-item">
						<span class="stat-value">{{ synopsisCount }}</span>
						<span class="stat-label">Synopsis Rédigé</span>
					</div>
					<div class="stat-divider"></div>
					<div class="stat-item">
						<span class="stat-value">{{ favoritesCount }}</span>
						<span class="stat-label">Favorites</span>
					</div>
				</div>
			</section>

			<section class="panel panel--profile-list" aria-labelledby="favorites-title">
				<div class="panel-header-row">
					<h2 id="favorites-title" class="section-title section-title--inline">
						<span class="jp" lang="ja">お気に入り</span>
						<span>Mes Favoris</span>
					</h2>
					<a class="see-all-link" href="{{ path('app_favorites') }}">Voir tout →</a>
				</div>

				{% if favoritesList is empty %}
					<p class="profile-empty-state">Vous n’avez encore aucun favori.</p>
				{% else %}
					<twig:OeuvreCard :results="favoritesList"/>
				{% endif %}
			</section>

			<section class="panel panel--profile-list" aria-labelledby="summaries-title">
				<div class="panel-header-row">
					<h2 id="summaries-title" class="section-title section-title--inline">
						<span class="jp" lang="ja">私の要約</span>
						<span>Mes Résumés</span>
					</h2>
					<a class="see-all-link" href="{{ path('app_my_summaries') }}">Voir tout →</a>
				</div>
				{% if summary_cards is empty %}
					<p class="profile-empty-state">Vous n’avez encore créé aucun résumé.</p>
				{% else %}
					<div class="summary-list-grid profile-summary-grid">
						{% for card in summary_cards %}
							{% include 'my_summary/_summary_card.html.twig' with {card: card} only %}
						{% endfor %}
					</div>
				{% endif %}
			</section>

			<form action="{{ path('app_logout') }}" method="post" class="logout-form">
				<button type="submit" class="btn-logout">
					<i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
					<span>Déconnexion</span>
				</button>
			</form>

			{% include 'components/_scroll_top.html.twig' with {target: 'main-content'} only %}
		</div>
	</main>

	{{ component('Navbar', { active: 'profile' }) }}
{% endblock %}
