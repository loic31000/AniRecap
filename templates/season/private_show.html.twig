{% extends 'base.html.twig' %}

{% block title %}{{ season.title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/season.css') }}">
    <link rel="stylesheet" href="{{ asset('css/spoiler-card.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
{% endblock %}

{% block body %}
    {{ component('Header', { backRoute: 'app_forms_index' }) }}

    <main class="page-season">
        <div class="season-inner">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash-{{ label }}" role="{{ label == 'error' ? 'alert' : 'status' }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            <a href="{{ path('app_forms_index') }}" class="back-link">Retour aux formulaires</a>

            <section class="season-hero">
                <figure class="season-cover" style="background-image: url('{{ season.coverSeasonUrl }}');">
                    <span class="visually-hidden">Miniature de {{ season.title }}</span>
                </figure>
                <div class="season-copy">
                    <h1 class="season-title">
                        <span class="season-title__main">{{ season.title }}</span>
                    </h1>
                    <p>Saison {{ season.number }} de {{ season.anime.title }}</p>
                    <div class="badge-row">
                        {% for category in season.categorie %}
                            <span class="badge">{{ category.name|upper }}</span>
                        {% endfor %}
                    </div>
                    <a href="{{ path('app_forms_season_edit', {id: season.id, return_to: app.request.requestUri}) }}" class="chip-btn">Modifier la saison</a>
                </div>
            </section>

            <section class="panel panel--synopsis" aria-labelledby="synopsis-title">
                <h2 id="synopsis-title" class="section-title">Description</h2>
                <p class="synopsis">{{ season.synopsis }}</p>
                <div class="info-grid">
                    <article class="info-item"><p class="info-label">TYPE</p><p class="info-value">{{ season.type }}</p></article>
                    <article class="info-item"><p class="info-label">STATUT</p><p class="info-value">{{ season.status }}</p></article>
                    <article class="info-item"><p class="info-label">AUTEUR</p><p class="info-value">{{ season.author }}</p></article>
                    <article class="info-item"><p class="info-label">ANNÉE</p><p class="info-value">{{ season.seasonDate }}</p></article>
                </div>
            </section>

            <section id="episodes" class="panel panel--episodes" aria-labelledby="episodes-title">
                <h2 id="episodes-title" class="section-title">Épisodes</h2>
                <p>
                    <a href="{{ path('app_forms_episode_create', {seasonId: season.id, return_to: app.request.requestUri}) }}" class="chip-btn">
                        Ajouter un épisode
                    </a>
                </p>

                {% if episodes is empty %}
                    <p class="episode-count-meta">Aucun épisode n’a encore été ajouté à cette saison.</p>
                {% else %}
                    <div class="episodes-timeline-list">
                        {% for episode in episodes %}
                            {% set linkedDiaporamas = episode_diaporamas[episode.id]|default([]) %}
                            <div class="timeline-item">
                                <div class="timeline-node" aria-hidden="true"><span class="play-circle"><i class="fa-solid fa-play"></i></span></div>
                                {% include 'components/_spoiler_card.html.twig' with {item_id: episode.id, title: episode.title, summary: episode.synopsis, status: episode.status, badge: 'ÉP. ' ~ episode.number, image_url: episode.coverEpisodeUrl, effective_level: episode_spoiler_levels[episode.id], linked_diaporamas: linkedDiaporamas, edit_route: 'app_forms_episode_edit', edit_class: 'card-edit-link', delete_route: 'app_forms_episode_delete', delete_token_id: 'episode_delete_', delete_message: 'Supprimer définitivement cet épisode, son résumé et ses scènes associées ?', delete_label: 'Supprimer ' ~ episode.title, summary_state: episode_summary_states[episode.id]|default(null)} only %}
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>
            <section class="panel panel--characters"><h2 class="section-title section-title--bilingual"><span lang="ja">登場人物</span><span>Personnages</span></h2>{% if characters is empty %}<p>Aucun personnage lié à cette saison.</p>{% else %}<div class="manga-characters-grid">{% for character in characters %}{% include 'components/_spoiler_card.html.twig' with {variant: 'character', effective_level: character.spoilerLevel, image_url: character.imageUrl ? path('app_character_image', {id: character.id}) : null, title: character.name, detail_url: path('app_character_show', {id: character.id, return_to: app.request.requestUri})} only %}{% endfor %}</div>{% endif %}</section>
        </div>
    </main>

    {{ component('Navbar', { active: 'forms' }) }}
{% endblock %}
