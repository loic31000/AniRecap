{# templates/season/season.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}
	{{ season.displayTitle|default('Gundam Seed Destiny') }}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/season.css') }}">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
{% endblock %}

{% block body %}
	{% set cover = season.coverImage is defined and season.coverImage is not empty ? season.coverImage : asset('images/coverSeason.png') %}
	{% set favorite = season.isFavorite|default(false) %}
	{% set formatLabel = season.format|default('Animé') %}
	{% set statusLabel = season.status|default('En cours') %}
	{% set authorLabel = season.author|default('Utilisateur17') %}
	{% set yearLabel = season.year|default(2005) %}
	{% set originalTitle = season.originalTitle|default('ガンダムSEED デスティニー') %}
	{% set displayTitle = season.displayTitle|default('Gundam Seed Destiny') %}
	{% set genres = season.genres|default(['Action', 'Fantasy', 'Shonen']) %}

	{% set arcTitle = season.arcTitle|default('STRIKE FREEDOM') %}
	{% set arcRange = season.arcRange|default('EP. 01 - EP. 15') %}
	{% set episodeDescription = season.episodeDescription|default("L'attaque surprise des Net-Hunters déstabilise la défense locale et force Kael à fuir.") %}
	{% set episodesCountText = season.episodesCountText|default('6 Épisodes disponibles') %}

	{% set castList = season.cast|default([
        {'name': 'Tsunayoshi Sawada', 'role': '澤田綱義'},
        {'name': 'Uchiha Sasuke', 'role': 'うずまき・ナルト'},
        {'name': 'Hajime No Hippo', 'role': 'ジン・モリ'}
    ]) %}

	{{ component('Header', { backRoute: 'app_home' }) }}

	<main class="page-season">
		<div class="season-inner">
			<a href="/anime" class="back-link">
				<i class="fa-solid fa-arrow-left"></i>
				<span>Retour au choix des saisons<span>
			</a>

			<section class="season-hero">
				<figure class="season-cover" style="background-image: url('{{ cover }}');">
					<span class="visually-hidden">Affiche de
						{{ displayTitle }}</span>
				</figure>

				<div class="season-copy">
					<h1 class="season-title">
						<span class="season-title__jp">{{ originalTitle }}</span>
						<span class="season-title__main">{{ displayTitle }}</span>
					</h1>

					<div class="badge-row">
						{% for genre in genres %}
							<span class="badge">{{ genre|upper }}</span>
						{% endfor %}
						<div class="secondary-actions">
							<button type="button" class="chip-btn">
								<i class="fa-solid fa-circle-play"></i>
								<span>DIAPORAMA</span>
							</button>
						</div>
					</div>

					<button type="button" class="btn-favorite{{ favorite ? ' is-active' : '' }}">
						<i class="fa-{{ favorite ? 'solid' : 'regular' }} fa-heart"></i>
						<span>Ajouter aux favoris</span>
					</button>


				</div>
			</section>

			{# Panneau Synopsis #}
			<section class="panel panel--synopsis" aria-labelledby="synopsis-title">
				<h2 id="synopsis-title" class="section-title">
					<span class="jp">あらすじ（全文）</span>
					<span>Synopsis complet</span>
				</h2>

				<p class="synopsis">{{ season.synopsis|default("Dans un monde régi par des lois immuables, un jeune héros se dresse contre l'adversité pour rétablir l'équilibre. Ce voyage initiatique le mènera à travers des contrées hostiles où chaque rencontre forgera sa destinée.") }}</p>
				<p class="synopsis">{{ season.synopsisExtra|default("Confronté à des dilemmes moraux et à des combats d'une intensité rare, il devra puiser au plus profond de lui-même pour éveiller le pouvoir latent qui sommeille en lui.") }}</p>
				<p class="synopsis">{{ season.synopsisConclusion|default("Une épopée magistrale qui explore les tréfonds de l'âme humaine sous un trait clinique et acéré.") }}</p>

				<div class="info-grid">
					<article class="info-item">
						<p class="info-label">
							<span class="jp">タイプ</span>TYPE</p>
						<p class="info-value">{{ formatLabel }}</p>
					</article>
					<article class="info-item">
						<p class="info-label">
							<span class="jp">定款</span>STATUT</p>
						<p class="info-value text-status">{{ statusLabel }}</p>
					</article>
					<article class="info-item">
						<p class="info-label">
							<span class="jp">著者</span>AUTEUR</p>
						<p class="info-value">{{ authorLabel }}</p>
					</article>
					<article class="info-item">
						<p class="info-label">
							<span class="jp">年</span>ANNÉE</p>
						<p class="info-value">{{ yearLabel }}</p>
					</article>
				</div>
			</section>

			{# Panneau Épisodes conforme au design Figma #}
			<section class="panel panel--episodes" aria-labelledby="episodes-title">
				<h2 id="episodes-title" class="section-title">
					<span>Episodes</span>
				</h2>

				{# Sous-titre placé sous la ligne dorée #}
				<p class="episode-count-meta">{{ episodesCountText|default('6 Episode disponibles') }}</p>

				<p class="episode-count-meta">Aucun épisode réel n’est disponible sur cette page.</p>

				{# Bouton d'action "Voir plus de chapitres" #}
				<div class="action-row-center">
					<button type="button" class="btn-figma-more">Voir plus de chapitres</button>
				</div>
			</section>

			{# Panneau Personnages (Rendu horizontal identique) #}
			<section class="panel panel--cast" aria-labelledby="cast-title">
				<h2 id="cast-title" class="section-title">
					<span class="jp">登場人物</span>
					<span>Personnages</span>
				</h2>

				<div class="cast-grid">
					{% for person in castList %}
						<article class="cast-card">
							<div class="cast-avatar-wrap">
								<div class="cast-avatar">
									<span>{{ person.name|slice(0, 1)|upper }}</span>
								</div>
							</div>
							<p class="cast-name">{{ person.name }}</p>
							<p class="cast-role">{{ person.role }}</p>
						</article>
					{% endfor %}
				</div>
			</section>
		</div>
	</main>

	{{ component('Navbar', { active: 'catalogue' }) }}
{% endblock %}
