{% extends 'base.html.twig' %}

{% block title %}Catalogue
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<meta name="turbo-cache-control" content="no-cache">
	<link rel="stylesheet" href="{{ asset('css/catalogue.css') }}">
	<link rel="stylesheet" href="{{ asset('css/searchCard.css') }}">
	<link rel="stylesheet" href="{{ asset('css/oeuvreCard.css') }}">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
{% endblock %}

{% block body %}
	<div class="catalogue-page catalogue-page--global" id="catalogue-top">
		{{ component('Header', { backRoute: 'app_home' }) }}

		<main class="catalogue-shell" id="main-content" tabindex="-1">
			<div class="catalogue-content">
				{% include 'components/_flash_messages.html.twig' %}

				<a href="{{ path('app_home') }}" class="retour-link">
					<i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
					Retour à l’accueil
				</a>

				<h1 class="page-title">
					<span><span lang="ja">カタログ</span> Catalogue</span>
				</h1>

				<twig:SearchCard :genres="genres" :filters="filters"/>

				<h2 class="section-title">
					<span><span lang="ja">カタログ</span> Catalogue</span>
				</h2>

				<twig:OeuvreCard :results="results"/>

				<a class="catalogue-scroll-top" href="#catalogue-top" aria-label="Retour en haut de la page">
					<i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
				</a>
			</div>
		</main>

		{{ component('Navbar', { active: 'catalogue' }) }}
	</div>
{% endblock %}
