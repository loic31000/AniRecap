{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/layout.css') }}">
    <link rel="stylesheet" href="{{ asset('css/login.css') }}">
{% endblock %}

{% block javascripts %}{% endblock %}

{% block body %}
<main class="login-page" id="main-content">
    <div class="login-card">

        <div class="logo-wrap">
            <img src="{{ asset('images/logo.webp') }}" alt="" class="logo-img" width="160" height="160" fetchpriority="high">
        </div>

        <h1 class="brand-title">AniRecap</h1>
        <p class="brand-subtitle">Connectez-vous à votre espace</p>

        {% if error %}
            <div class="flash-error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form class="login-form" method="post" aria-label="Connexion à AniRecap">

            <div class="form-group">
                <label for="inputEmail">Adresse e-mail</label>
                <div class="input-icon">
                    <span class="field-icon" aria-hidden="true">✉</span>
                    <input
                        type="email"
                        value="{{ last_username }}"
                        name="email"
                        id="inputEmail"
                        autocomplete="email"
                        required
                        autofocus
                        placeholder="nom@exemple.fr"
                    >
                </div>
            </div>

            <div class="form-group">
                <label for="inputPassword">Mot de passe</label>
                <div class="input-icon">
                    <span class="field-icon" aria-hidden="true">●</span>
                    <input
                        type="password"
                        name="password"
                        id="inputPassword"
                        autocomplete="current-password"
                        required
                        placeholder="Votre mot de passe"
                    >
                </div>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="submit-btn">
                Se connecter <span aria-hidden="true">→</span>
            </button>
        </form>

        <p class="login-link">
            <a href="{{ path('app_register') }}">Nouvel utilisateur ?</a>
        </p>
    </div>
</main>
{% endblock %}
