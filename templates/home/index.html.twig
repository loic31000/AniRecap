{% extends 'base.html.twig' %}

{% block title %}Accueil AniRecap{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/catalogue.css') }}">
    <link rel="stylesheet" href="{{ asset('css/oeuvreCard.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
{% endblock %}

{% block body %}
    <div class="catalogue-page">
        {{ component('Header', { backRoute: null }) }}

        <main class="catalogue-shell">
            <div class="catalogue-content">
                <h1 class="page-title"><span>ホーム Accueil</span></h1>
                <p>
                    Retrouvez les œuvres publiques et les créations privées de votre espace.
                </p>
                <p>
                    <a href="{{ path('app_catalogue') }}" class="retour-link">
                        Rechercher dans le catalogue
                        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                    </a>
                </p>

                <section aria-labelledby="popular-title">
                    <h2 id="popular-title" class="section-title"><span>Populaire</span></h2>
                    <twig:OeuvreCard :results="popular"/>
                </section>

                <section aria-labelledby="latest-title">
                    <h2 id="latest-title" class="section-title"><span>Dernière modification</span></h2>
                    <twig:OeuvreCard :results="latest"/>
                </section>
            </div>
        </main>

        {{ component('Navbar', { active: 'home' }) }}
    </div>
{% endblock %}
