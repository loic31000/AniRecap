{% extends 'base.html.twig' %}

{% block title %}{{ anime.title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/anime.css') }}">
    <link rel="stylesheet" href="{{ asset('css/oeuvreCard.css') }}">
    <link rel="stylesheet" href="{{ asset('css/spoiler-card.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
{% endblock %}

{% block body %}
    {% set cover = anime.coverAnimeUrl ?: asset('images/coverAnime.png') %}

    {{ component('Header', { backRoute: 'app_catalogue' }) }}

    <main class="page-anime">
        <div class="anime-inner">
            {% include 'components/_flash_messages.html.twig' %}
            <a href="{{ path('app_catalogue') }}" class="back-link">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                <span>Retour au Catalogue</span>
            </a>

            <section class="anime-hero">
                <figure class="anime-cover" style="background-image: url('{{ cover }}');">
                    <span class="visually-hidden">Affiche de {{ anime.title }}</span>
                </figure>
                <div class="anime-copy">
                    <h1 class="anime-title"><span class="anime-title__main">{{ anime.title }}</span></h1>
                    <div class="badge-row">
                        {% for category in anime.categories %}
                            <span class="badge">{{ category.name|upper }}</span>
                        {% endfor %}
                        {% if not anime.isPublic %}
                            <span class="badge">PRIVÉ</span>
                        {% endif %}
                    </div>
                    <div class="detail-favorite-action">{% include 'components/_favorite_toggle.html.twig' with {oeuvre: favorite_oeuvre, modifier: 'favorite-toggle-form--detail'} only %}<span>{{ favorite_oeuvre.isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' }}</span></div>
                </div>
            </section>

            <section class="panel panel--synopsis" aria-labelledby="synopsis-title">
                <h2 id="synopsis-title" class="section-title">Synopsis complet</h2>
                {% if anime.synopsis %}
                    <p class="synopsis">{{ anime.synopsis }}</p>
                {% else %}
                    <p class="synopsis">Aucun synopsis renseigné.</p>
                {% endif %}
                <div class="info-grid">
                    <article class="info-item"><p class="info-label">TYPE</p><p class="info-value">{{ anime.type ?: 'Non renseigné' }}</p></article>
                    <article class="info-item"><p class="info-label">STATUT</p><p class="info-value">{{ anime.status ?: 'Non renseigné' }}</p></article>
                    <article class="info-item"><p class="info-label">AUTEUR</p><p class="info-value">{{ anime.author ?: 'Non renseigné' }}</p></article>
                    <article class="info-item"><p class="info-label">ANNÉE</p><p class="info-value">{{ anime.animeDate ?: 'Non renseignée' }}</p></article>
                </div>
            </section>

            <section class="panel panel--animes" aria-labelledby="seasons-title">
                <h2 id="seasons-title" class="section-title">Saisons</h2>
                {% if anime.seasons is empty %}
                    <p>Aucune saison disponible.</p>
                {% else %}
                    <div class="anime-list">
                        {% for season in anime.seasons %}
                            {% if is_owner and not anime.isPublic %}
                                <a href="{{ path('app_private_season_show', {id: season.id}) }}" class="anime-row">
                                    <span class="anime-row__name">Saison {{ season.number }} — {{ season.title }}</span>
                                </a>
                            {% else %}
                                <div class="anime-row">
                                    <span class="anime-row__name">Saison {{ season.number }} — {{ season.title }}</span>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}
            </section>
        </div>
    </main>

    {{ component('Navbar', { active: 'catalogue' }) }}
{% endblock %}
