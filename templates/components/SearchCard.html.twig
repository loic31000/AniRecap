{% set currentQ = filters.q|default('') %}
{% set currentType = filters.type|default('all') %}
{% set currentGenre = filters.genre|default(null) %}
{% set currentYear = filters.annee|default(null) %}
{% set currentDate = filters.date|default(null) %}
{% set componentId = 'search-card-' ~ actionRoute|replace({'_': '-'}) %}
{% set activeGenreName = 'Genre' %}
{% for genre in genres %}{% if genre.slug == currentGenre %}{% set activeGenreName = genre.name %}{% endif %}{% endfor %}

<div data-controller="search-card"
     data-search-card-selected-date-value="{{ currentDate ?: '' }}"
     data-search-card-current-year-value="{{ currentYear ?: 0 }}">
    <section class="search-card" aria-label="Recherche et filtres">
        <form class="search-form" method="get" action="{{ path(actionRoute) }}" data-search-card-target="form">
            <input type="hidden" name="type" value="{{ currentType }}" data-search-card-target="type">
            <input type="hidden" name="genre" value="{{ currentGenre ?: '' }}" data-search-card-target="genre">
            <input type="hidden" name="annee" value="{{ currentYear ?: '' }}" data-search-card-target="year">
            <input type="hidden" name="date" value="{{ currentDate ?: '' }}" data-search-card-target="date">

            <div class="search-wrapper">
                <label class="visually-hidden" for="{{ componentId }}-query">Rechercher une œuvre</label>
                <input type="search" name="q" id="{{ componentId }}-query" placeholder="Rechercher une œuvre..."
                       value="{{ currentQ }}" maxlength="120" autocomplete="off" data-search-card-target="query">
                <button type="submit" class="search-submit" aria-label="Lancer la recherche">
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                </button>
            </div>

            <div class="filter-row" aria-label="Type d’œuvre">
                {% for value, label in {'all': 'Tous', 'anime': 'Anime', 'manga': 'Manga'} %}
                    <button type="button" class="filter-pill {{ currentType == value ? 'is-active' : '' }}"
                            aria-pressed="{{ currentType == value ? 'true' : 'false' }}"
                            data-value="{{ value }}" data-action="search-card#selectType">{{ label }}</button>
                {% endfor %}
            </div>

            <div class="filter-row">
                <div class="custom-dropdown" data-search-card-target="genreDropdown">
                    <button type="button" class="filter-pill filter-pill--dropdown {{ currentGenre ? 'is-active' : '' }}"
                            aria-expanded="false" aria-controls="{{ componentId }}-genres"
                            data-search-card-target="genreTrigger" data-action="search-card#toggleGenre">
                        <span data-search-card-target="genreLabel">{{ activeGenreName }}</span>
                        <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                    </button>
                    <div class="custom-dropdown-menu" id="{{ componentId }}-genres" role="menu" hidden data-search-card-target="genreMenu">
                        <button type="button" role="menuitem" class="custom-dropdown-item {{ currentGenre is null ? 'is-selected' : '' }}"
                                data-value="" data-label="Genre" data-action="search-card#selectGenre">Tous les genres</button>
                        {% for genre in genres %}
                            <button type="button" role="menuitem" class="custom-dropdown-item {{ currentGenre == genre.slug ? 'is-selected' : '' }}"
                                    data-value="{{ genre.slug }}" data-label="{{ genre.name }}" data-action="search-card#selectGenre">{{ genre.name }}</button>
                        {% endfor %}
                    </div>
                </div>

                <button type="button" class="filter-pill filter-pill--dropdown {{ currentYear ? 'is-active' : '' }}"
                        aria-haspopup="dialog" aria-controls="{{ componentId }}-calendar"
                        data-action="search-card#openCalendar" data-search-card-target="calendarTrigger">
                    <span data-search-card-target="yearLabel">{{ currentYear ?: 'Date' }}</span>
                    <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                </button>
            </div>

        </form>
        <noscript>
            <form class="search-card-fallback" method="get" action="{{ path(actionRoute) }}">
                <label>Recherche <input type="search" name="q" value="{{ currentQ }}" maxlength="120"></label>
                <label>Type <select name="type"><option value="all">Tous</option><option value="anime">Anime</option><option value="manga">Manga</option></select></label>
                <label>Genre <select name="genre"><option value="">Tous</option>{% for genre in genres %}<option value="{{ genre.slug }}">{{ genre.name }}</option>{% endfor %}</select></label>
                <label>Date <input type="date" name="date" value="{{ currentDate ?: '' }}"></label>
                <button type="submit">Appliquer les filtres</button>
            </form>
        </noscript>
    </section>

    {% if currentQ or currentType != 'all' or currentGenre or currentYear %}
        <div class="active-filters" aria-label="Filtres actifs">
            <span class="active-filters-label">Filtres actifs :</span>
            {% if currentQ %}<button type="button" class="active-chip" data-filter="q" data-action="search-card#clearFilter">« {{ currentQ }} » <i class="fa-solid fa-xmark" aria-hidden="true"></i></button>{% endif %}
            {% if currentType != 'all' %}<button type="button" class="active-chip" data-filter="type" data-action="search-card#clearFilter">{{ currentType|capitalize }} <i class="fa-solid fa-xmark" aria-hidden="true"></i></button>{% endif %}
            {% if currentGenre %}<button type="button" class="active-chip" data-filter="genre" data-action="search-card#clearFilter">{{ activeGenreName }} <i class="fa-solid fa-xmark" aria-hidden="true"></i></button>{% endif %}
            {% if currentYear %}<button type="button" class="active-chip" data-filter="date" data-action="search-card#clearFilter">{{ currentDate ?: currentYear }} <i class="fa-solid fa-xmark" aria-hidden="true"></i></button>{% endif %}
            <button type="button" class="clear-filters" data-action="search-card#clearAll">Tout effacer</button>
        </div>
    {% endif %}

    <div id="{{ componentId }}-calendar" class="calendar-overlay" role="dialog" aria-modal="true" aria-labelledby="{{ componentId }}-calendar-title"
         hidden data-search-card-target="calendar" data-action="click->search-card#calendarBackdrop keydown@window->search-card#escape">
        <section class="calendar-dialog">
            <header class="calendar-header">
                <h2 id="{{ componentId }}-calendar-title">Calendrier</h2>
                <button type="button" class="calendar-reset" data-action="search-card#resetCalendar">Réinitialiser</button>
            </header>
            <div class="calendar-navigation">
                <button type="button" class="calendar-arrow" aria-label="Mois précédent" data-action="search-card#previousMonth"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
                <div><strong data-search-card-target="monthLabel"></strong><small>SÉLECTION DE DATE</small></div>
                <button type="button" class="calendar-arrow" aria-label="Mois suivant" data-action="search-card#nextMonth"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
            </div>
            <div class="calendar-weekdays" aria-hidden="true"><span>L</span><span>M</span><span>M</span><span>J</span><span>V</span><span>S</span><span>D</span></div>
            <div class="calendar-grid" role="grid" aria-label="Jours du mois" data-search-card-target="calendarGrid"></div>
            <div class="calendar-selection" aria-live="polite"><span>DATE SÉLECTIONNÉE</span><strong data-search-card-target="selectedDateLabel">Aucune date</strong></div>
            <footer class="calendar-actions">
                <button type="button" class="calendar-confirm" data-action="search-card#confirmDate"><i class="fa-regular fa-calendar-check" aria-hidden="true"></i> Confirmer la date</button>
                <button type="button" class="calendar-cancel" data-action="search-card#closeCalendar">ANNULER</button>
            </footer>
        </section>
    </div>
</div>
