{% set currentQ = filters is defined ? filters.q|default('') : app.request.query.get('q', '') %}
{% set currentType = filters is defined ? filters.type|default('all') : app.request.query.get('type', 'all') %}
{% set currentGenre = filters is defined ? filters.genre|default('') : app.request.query.get('genre', '') %}
{% set currentYear = filters is defined ? filters.annee|default('') : app.request.query.get('annee', '') %}

{# Trouver le nom du genre sélectionné pour l'afficher sur le bouton et le badge #}
{% set activeGenreName = 'Genre' %}
{% for genre in genres %}
    {% if genre.slug == currentGenre %}
        {% set activeGenreName = genre.name %}
    {% endif %}
{% endfor %}

<section class="search-card">
    {# Formulaire principal contenant tous les filtres sous forme de champs cachés #}
    <form class="search-form" method="get" action="{{ path('app_catalogue') }}" id="catalogue-filters-form">
        <input type="hidden" name="type" id="filter-type" value="{{ currentType }}">
        <input type="hidden" name="genre" id="filter-genre" value="{{ currentGenre }}">
        <input type="hidden" name="annee" id="filter-annee" value="{{ currentYear }}">

        <div class="search-wrapper">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" name="q" id="search-input" placeholder="Rechercher une œuvre..." value="{{ currentQ }}" autocomplete="off">
        </div>
    </form>

    {# Première ligne de filtres : Types #}
    <div class="filter-row">
        <button type="button" class="filter-pill {{ currentType == 'all' ? 'is-active' : '' }}" data-type-btn="all">
            Tous
        </button>
        <button type="button" class="filter-pill {{ currentType == 'anime' ? 'is-active' : '' }}" data-type-btn="anime">Anime</button>
        <button type="button" class="filter-pill {{ currentType == 'manga' ? 'is-active' : '' }}" data-type-btn="manga">Manga</button>
    </div>

    {# Deuxième ligne de filtres : Dropdowns pour Genre et Année #}
    <div class="filter-row">
        <div class="custom-dropdown">
            <button type="button" class="filter-pill filter-pill--dropdown {{ currentGenre ? 'is-active' : '' }}" data-dropdown-trigger="genre">
                {{ activeGenreName }}
                <i class="fa-solid fa-chevron-down"></i>
            </button>
            <div class="custom-dropdown-menu" id="menu-genre">
                <div class="custom-dropdown-item {{ currentGenre == '' ? 'is-selected' : '' }}" data-value="">Tous les genres</div>
                {% for genre in genres %}
                    <div class="custom-dropdown-item {{ currentGenre == genre.slug ? 'is-selected' : '' }}" data-value="{{ genre.slug }}">
                        {{ genre.name }}
                    </div>
                {% endfor %}
            </div>
        </div>

        <div class="custom-dropdown">
            <button type="button" class="filter-pill filter-pill--dropdown {{ currentYear ? 'is-active' : '' }}" data-dropdown-trigger="annee">
                {{ currentYear ?: 'Année' }}
                <i class="fa-regular fa-calendar"></i>
            </button>
            <div class="custom-dropdown-menu" id="menu-annee">
                <div class="custom-dropdown-item {{ currentYear == '' ? 'is-selected' : '' }}" data-value="">Toutes les années</div>
                {% for year in [2026, 2025, 2024, 2023, 2022, 2021, 2020] %}
                    <div class="custom-dropdown-item {{ currentYear == year ? 'is-selected' : '' }}" data-value="{{ year }}">
                        {{ year }}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

{# Zone des filtres actifs #}
{% if currentQ or currentType != 'all' or currentGenre or currentYear %}
    <div class="active-filters">
        <span class="active-filters-label">Filtres actifs :</span>
        
        {% if currentQ %}
            <span class="active-chip" data-clear="q">
                « {{ currentQ }} » <i class="fa-solid fa-xmark"></i>
            </span>
        {% endif %}

        {% if currentType != 'all' %}
            <span class="active-chip" data-clear="type">
                {{ currentType|capitalize }} <i class="fa-solid fa-xmark"></i>
            </span>
        {% endif %}

        {% if currentGenre %}
            <span class="active-chip" data-clear="genre">
                {{ activeGenreName }} <i class="fa-solid fa-xmark"></i>
            </span>
        {% endif %}

        {% if currentYear %}
            <span class="active-chip" data-clear="annee">
                {{ currentYear }} <i class="fa-solid fa-xmark"></i>
            </span>
        {% endif %}

        <button type="button" class="clear-filters">Tout effacer</button>
    </div>
{% endif %}

{# Le JavaScript pour animer tes boutons et soumettre le formulaire automatiquement #}
<script>
window.initSearchCard = window.initSearchCard || (() => {
    const form = document.getElementById('catalogue-filters-form');
    const inputType = document.getElementById('filter-type');
    const inputGenre = document.getElementById('filter-genre');
    const inputAnnee = document.getElementById('filter-annee');
    const inputQ = document.getElementById('search-input');

    // 1. Gestion des boutons de Type (Tous / Anime / Manga)
    document.querySelectorAll('[data-type-btn]').forEach(btn => {
        btn.addEventListener('click', () => {
            inputType.value = btn.dataset.typeBtn;
            form.submit();
        });
    });

    // 2. Ouverture/Fermeture des Dropdowns (Genre / Année)
    document.querySelectorAll('[data-dropdown-trigger]').forEach(trigger => {
        trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            const parent = trigger.parentElement;
            
            // Fermer les autres dropdowns ouverts
            document.querySelectorAll('.custom-dropdown').forEach(d => {
                if (d !== parent) d.classList.remove('is-open');
            });
            
            parent.classList.toggle('is-open');
        });
    });

    // Fermer les menus si on clique n'importe où ailleurs sur la page
    document.addEventListener('click', () => {
        document.querySelectorAll('.custom-dropdown').forEach(dropdown => {
            dropdown.classList.remove('is-open');
        });
    });

    // 3. Clic sur un élément à l'intérieur d'un dropdown
    document.querySelectorAll('.custom-dropdown-menu').forEach(menu => {
        menu.addEventListener('click', (e) => {
            e.stopPropagation();
        });

        const isGenreMenu = menu.id === 'menu-genre';
        
        menu.querySelectorAll('.custom-dropdown-item').forEach(item => {
            item.addEventListener('click', () => {
                if (isGenreMenu) {
                    inputGenre.value = item.dataset.value;
                } else {
                    inputAnnee.value = item.dataset.value;
                }
                form.submit();
            });
        });
    });

    // 4. Suppression individuelle des filtres actifs (les puces "active-chip")
    const activeFiltersContainer = document.querySelector('.active-filters');
    const clearChip = (chip) => {
        if (!chip) {
            return;
        }

        const target = chip.dataset.clear;
        if (target === 'q') inputQ.value = '';
        if (target === 'type') inputType.value = 'all';
        if (target === 'genre') inputGenre.value = '';
        if (target === 'annee') inputAnnee.value = '';
        form.submit();
    };

    if (activeFiltersContainer) {
        activeFiltersContainer.addEventListener('click', (event) => {
            const chip = event.target.closest('[data-clear]');
            clearChip(chip);
        });
    }

    document.querySelectorAll('[data-clear]').forEach(chip => {
        chip.addEventListener('click', (event) => {
            event.preventDefault();
            clearChip(chip);
        });
    });

    // 5. Bouton "Tout effacer"
    const clearAllBtn = document.querySelector('.clear-filters');
    if (clearAllBtn) {
        clearAllBtn.addEventListener('click', () => {
            inputQ.value = '';
            inputType.value = 'all';
            inputGenre.value = '';
            inputAnnee.value = '';
            form.submit();
        });
    }
});

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', window.initSearchCard);
} else {
    window.initSearchCard();
}
</script>