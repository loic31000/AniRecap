{% set favorite = oeuvre.isFavorite|default(false) %}
<form class="favorite-toggle-form {{ modifier|default('') }}" method="post" action="{{ path(favorite ? 'app_favorite_remove' : 'app_favorite_add', {type: oeuvre.type, id: oeuvre.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token((favorite ? 'favorite_remove_' : 'favorite_add_') ~ oeuvre.type ~ '_' ~ oeuvre.id) }}">
    <input type="hidden" name="return_to" value="{{ app.request.requestUri }}">
    <button class="favorite-toggle-button{{ favorite ? ' is-active' : '' }}" type="submit" aria-label="{{ favorite ? 'Retirer ' ~ oeuvre.title ~ ' des favoris' : 'Ajouter ' ~ oeuvre.title ~ ' aux favoris' }}">
        <i class="{{ favorite ? 'fa-solid' : 'fa-regular' }} fa-star" aria-hidden="true"></i>
    </button>
</form>
