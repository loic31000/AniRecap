{% set oeuvres = results|default([]) %}

{% if oeuvres is empty %}
    <div class="empty-results" role="status">
        <p>Aucune œuvre disponible.</p>
    </div>
{% else %}
    <div class="oeuvre-list">
        {% for oeuvre in oeuvres %}
            <article class="oeuvre-card">
                <a
                    href="{{ oeuvre.type == 'anime'
                        ? path('app_anime_show', {id: oeuvre.id})
                        : path('app_manga_show', {id: oeuvre.id}) }}"
                    class="oeuvre-card-link"
                    aria-label="Voir {{ oeuvre.title }}"
                ></a>

                <div class="oeuvre-thumb">
                    <img
                        src="{{ oeuvre.cover ?: asset(oeuvre.type == 'anime' ? 'images/coverAnime.png' : 'images/coverMangaCard.png') }}"
                        alt="Miniature de {{ oeuvre.title }}"
                        class="oeuvre-thumb-image"
                    >
                </div>
                {% include 'components/_favorite_toggle.html.twig' with {oeuvre: oeuvre} only %}

                <div class="oeuvre-body">
                    <div class="oeuvre-meta">
                        <span class="badge-type badge-type--{{ oeuvre.type }}">{{ oeuvre.type }}</span>
                        {% if oeuvre.category|default(null) %}
                            <span class="badge-type">{{ oeuvre.category }}</span>
                        {% endif %}
                        {% if oeuvre.isPrivate %}
                            <span class="badge-type">Privé</span>
                        {% endif %}
                    </div>

                    <h3 class="oeuvre-title">{{ oeuvre.title }}</h3>
                    <p class="oeuvre-subtitle">{{ oeuvre.subtitle }}</p>

                    <div class="oeuvre-footer">
                        <span class="oeuvre-date">
                            {% if oeuvre.date %}
                                <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
                                {{ oeuvre.dateLabel|default('') }} {{ oeuvre.date }}
                            {% else %}
                                Date non renseignée
                            {% endif %}
                        </span>
                        <span class="oeuvre-votes">{{ oeuvre.votesCount }} vote{{ oeuvre.votesCount > 1 ? 's' : '' }}</span>
                    </div>
                </div>
            </article>
        {% endfor %}
    </div>
{% endif %}
