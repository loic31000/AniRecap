<header class="app-header">
	<div class="app-header-inner">
		{% if backRoute %}
			<a href="{{ path(backRoute) }}" class="back-link" aria-label="Retour à la page précédente">
				<i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
			</a>
		{% else %}
			<span class="header-spacer"></span>
		{% endif %}

		<a href="{{ path('app_home') }}" class="app-header-brand" aria-label="AniRecap — Accueil">
			<img class="app-header-brand__logo" src="{{ asset('images/logo.webp') }}" alt="" width="160" height="160">
			<img class="app-header-brand__title" src="{{ asset('images/AniRecap.svg') }}" alt="" width="144" height="38">
		</a>

		<span class="header-spacer"></span>
	</div>
</header>
