{% extends 'base.html.twig' %}

{% block title %}{{ diaporama.title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/diaporama.css') }}">
{% endblock %}

{% block body %}
{% set return_to = app.request.query.get('return_to') %}
{% set return_url = return_to and return_to starts with '/' and not (return_to starts with '//') ? return_to : path('app_forms_index') %}
<main
    id="main-content"
    tabindex="-1"
    class="story"
    data-controller="diaporama-reader"
    data-action="click->diaporama-reader#tap keydown@window->diaporama-reader#keydown"
>
    <div class="story__actions">
        <a href="{{ path(diaporama.sourceType == 'anime' ? 'app_diaporama_scene_anime_create' : 'app_diaporama_scene_manga_create', {id: diaporama.id, return_to: app.request.requestUri}) }}">
            Ajouter une scène
        </a>
    </div>

    <div
        class="story__progress"
        role="group"
        aria-label="Progression du diaporama"
        style="--story-slide-count: {{ items|length }}"
    >
        {% for item in items %}
            <span
                class="story__progress-bar{{ loop.first ? ' is-active' : '' }}"
                data-diaporama-reader-target="segment"
                aria-label="Slide {{ loop.index }}"
                {% if loop.first %}aria-current="step"{% endif %}
            ></span>
        {% endfor %}
    </div>
    {% if items is not empty %}
        <p class="story__progress-status" data-diaporama-reader-target="status" role="status" aria-live="polite">
            Slide 1 sur {{ items|length }}
        </p>
    {% endif %}

    <a href="{{ return_url }}" class="story__close" aria-label="Fermer le lecteur">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="4" y1="4" x2="20" y2="20"/>
            <line x1="20" y1="4" x2="4" y2="20"/>
        </svg>
    </a>

    {% if items is empty %}
        <section class="story__empty">
            <h1>{{ diaporama.title }}</h1>
            <p>Ce diaporama ne contient encore aucune scène.</p>
            <a href="{{ path(diaporama.sourceType == 'anime' ? 'app_diaporama_scene_anime_create' : 'app_diaporama_scene_manga_create', {id: diaporama.id, return_to: app.request.requestUri}) }}">
                Ajouter la première scène
            </a>
        </section>
    {% endif %}

    {% for item in items %}
        {% set seriesTitle = item.episode.season.anime.title
            ?? item.tome.manga.title
            ?? item.chapitre.manga.title %}
        {% set presentation = slide_presentations[item.id] %}

        {% set imageUrl = item.imageFilename
            ? path('app_diaporama_slide_image', {diaporamaId: diaporama.id, slideId: item.id})
            : null %}

        <section
            class="story__slide{{ loop.first ? ' is-active' : '' }}"
            data-diaporama-reader-target="slide"
            aria-hidden="{{ loop.first ? 'false' : 'true' }}"
        >
            {% if imageUrl %}
                <img
                    src="{{ imageUrl }}"
                    alt="Image de la slide {{ loop.index }} : {{ item.title }}"
                    class="story__background"
                >
            {% endif %}

            <h1 class="story__series-title">{{ presentation.workTitle ?: seriesTitle }}</h1>

            <div class="story__card">
                {% if presentation.categories is not empty %}
                    <div class="story__categories" aria-label="Catégories de l’œuvre">
                        {% for category in presentation.categories %}
                            <span class="story__badge">{{ category|upper }}</span>
                        {% endfor %}
                    </div>
                {% endif %}

                <h2 class="story__work-title">{{ presentation.workTitle }}</h2>
                <h3 class="story__slide-title">{{ item.title }}</h3>

                {% if presentation.link %}
                    <a
                        href="{{ presentation.link }}"
                        class="story__link"
                        target="_blank"
                        rel="noopener noreferrer"
                    >{{ presentation.link }}</a>
                {% endif %}

                <div class="story__description">
                    {{ presentation.summary|striptags }}
                </div>
                {% if item.startTimecodeSeconds is not null %}
                    <p class="story__timecode">
                        {{ '%02d:%02d'|format((item.startTimecodeSeconds / 60)|round(0, 'floor'), item.startTimecodeSeconds % 60) }}
                        {% if item.endTimecodeSeconds is not null %}
                            à {{ '%02d:%02d'|format((item.endTimecodeSeconds / 60)|round(0, 'floor'), item.endTimecodeSeconds % 60) }}
                        {% endif %}
                    </p>
                {% endif %}
                <p class="story__spoiler">
                    <span>Niveau de spoiler</span>
                    <strong>{{ item.spoilerLevel.value|upper }}</strong>
                </p>
            </div>
        </section>
    {% endfor %}

    {% if items is not empty %}
        <div class="story__controls" role="group" aria-label="Navigation entre les slides">
            <button
                type="button"
                class="story__control story__control--previous"
                aria-label="Slide précédente"
                data-diaporama-reader-target="control"
                data-action="click->diaporama-reader#previous"
                {% if items|length == 1 %}disabled{% endif %}
            >‹</button>
            <button
                type="button"
                class="story__control story__control--next"
                aria-label="Slide suivante"
                data-diaporama-reader-target="control"
                data-action="click->diaporama-reader#next"
                {% if items|length == 1 %}disabled{% endif %}
            >›</button>
        </div>
    {% endif %}
</main>
{% endblock %}
